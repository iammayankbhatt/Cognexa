# Root env used by docker-compose.yml only. Copy to .env (gitignored).
# App-specific variables live in apps/api/.env.example and apps/web/.env.example.

# Host ports for the local containers
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
# 5433 (not 5432) so it does not clash with a native Postgres install
POSTGRES_PORT=5433

# Local-dev credentials (never reuse in production)
NEO4J_PASSWORD=cognexa_dev_password
POSTGRES_USER=cognexa
POSTGRES_PASSWORD=cognexa_dev_password
POSTGRES_DB=cognexa
