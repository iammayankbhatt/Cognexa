# Cognexa API environment. Copy to .env (gitignored). Never commit real values.

# Runtime environment label: development | test | production
APP_ENV=development

# Python log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Comma-separated CORS origins allowed to call the API
ALLOWED_ORIGINS=http://localhost:3000

# Postgres connection string (Supabase pooler in prod; local docker in dev).
# Format: postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DB
DATABASE_URL=postgresql+asyncpg://cognexa:cognexa_dev_password@localhost:5432/cognexa

# Neo4j connection (local docker: bolt://localhost:7687; Aura: neo4j+s://<id>.databases.neo4j.io)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=cognexa_dev_password

# Timeout (seconds) for each dependency probe in /health/deep
HEALTH_CHECK_TIMEOUT_S=3
