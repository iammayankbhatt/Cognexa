# Cognexa API environment. Copy to .env (gitignored). Never commit real values.
# REPLACE_ME marks a cloud value you must fill in before the matching feature works live.
# scripts/check_env.py reports SET / MISSING / PLACEHOLDER for each variable (never prints values).

# ---------------------------------------------------------------- runtime (phase 1)
# Runtime environment label: development | test | production
APP_ENV=development
# Python log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# Comma-separated CORS origins allowed to call the API
ALLOWED_ORIGINS=http://localhost:3000
# Timeout (seconds) for each dependency probe in /health/deep
HEALTH_CHECK_TIMEOUT_S=3

# ---------------------------------------------------------------- databases (phase 1-2)
# Postgres connection string (Supabase pooler in prod; local docker in dev).
# Local docker maps Postgres to host port 5433 (see root .env.example).
# Format: postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DB
DATABASE_URL=postgresql+asyncpg://cognexa:cognexa_dev_password@localhost:5433/cognexa
# Neo4j connection (local docker: bolt://localhost:7687; Aura: neo4j+s://<id>.databases.neo4j.io)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=cognexa_dev_password
# Subject loaded by the seed scripts (folder under data/subjects/)
DEFAULT_SUBJECT_ID=dsa

# ---------------------------------------------------------------- embeddings (phase 2-3, 5)
# Embedding provider: fake (deterministic, local) | gemini
EMBEDDING_PROVIDER=fake
# Embedding model id (only used by real providers; never hardcoded in code)
EMBEDDING_MODEL=fake-embedding
# Vector size. MUST equal the vector(N) column in supabase/migrations (default 768).
# To change it: add a new migration that alters content_chunks.embedding to vector(N),
# set EMBEDDING_DIM=N, then re-run scripts/seed_vectors.py. seed_vectors.py refuses to run on a mismatch.
EMBEDDING_DIM=768

# ---------------------------------------------------------------- auth (phase 4)
# Supabase project URL + service-role key (backend only, never in the web app) + JWKS URL for JWT verification.
SUPABASE_URL=REPLACE_ME
SUPABASE_SERVICE_ROLE_KEY=REPLACE_ME
SUPABASE_JWKS_URL=REPLACE_ME
# Legacy HS256 JWT secret (only if the project still uses it; local tests sign their own tokens).
SUPABASE_JWT_SECRET=REPLACE_ME

# ---------------------------------------------------------------- LLM providers (phase 5-6)
# Provider ids: fake (deterministic, local) | groq | gemini. Model ids come only from env.
LLM_PRIMARY_PROVIDER=fake
LLM_PRIMARY_MODEL=fake-model
LLM_FALLBACK_PROVIDER=fake
LLM_FALLBACK_MODEL=fake-model
LLM_JUDGE_PROVIDER=fake
LLM_JUDGE_MODEL=fake-model
GROQ_API_KEY=REPLACE_ME
GEMINI_API_KEY=REPLACE_ME
# Optional. Gemini API version for the google-genai SDK (empty = SDK default). Set v1beta if a
# model or structured JSON output needs the beta API (scripts/llm_smoke.py shows a 400 otherwise).
GEMINI_API_VERSION=
# Optional. OpenAI-compatible Groq endpoint and per-call timeout in seconds.
GROQ_BASE_URL=https://api.groq.com/openai/v1
LLM_TIMEOUT_S=30
# Real setup example (pick current model ids from the provider docs; never hard-coded in code):
#   LLM_PRIMARY_PROVIDER=groq   LLM_PRIMARY_MODEL=<groq model id>
#   LLM_FALLBACK_PROVIDER=gemini LLM_FALLBACK_MODEL=<gemini model id>
#   EMBEDDING_PROVIDER=gemini   EMBEDDING_MODEL=<gemini embedding model id>  EMBEDDING_DIM=768
# Then run: uv run --project apps/api python scripts/llm_smoke.py

# ---------------------------------------------------------------- feature flags (phase 6, 12)
AGENTIC_MODE=true
STUDY_MODE=false

# ---------------------------------------------------------------- tutor pipeline (phase 6, optional)
# Classifier confidence below which the hybrid fulltext + embedding fallback also runs.
CLASSIFY_THRESHOLD=0.55
# Token budget for the retrieved context of one answer (same for graphrag and plain_rag).
CONTEXT_TOKEN_BUDGET=3000
# Chunks retrieved by the plain-RAG baseline (pgvector cosine top-k).
PLAIN_RAG_TOP_K=6
# Previous user/assistant exchanges sent with each question (for follow-ups like "why?").
TUTOR_HISTORY_TURNS=4

# ---------------------------------------------------------------- optional
# Sentry DSN for error tracking (leave empty to disable)
SENTRY_DSN=
