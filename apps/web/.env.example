# Cognexa web environment. Copy to .env.local (gitignored). Only NEXT_PUBLIC_* values reach the browser.

# Base URL of the FastAPI backend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase project URL and anon (public) key, used for auth only (Phase 4)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
