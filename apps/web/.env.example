# Cognexa web environment. Copy to .env.local (gitignored). Only NEXT_PUBLIC_* values reach the browser.
# REPLACE_ME marks a cloud value you must fill in before the matching feature works live.

# Base URL of the FastAPI backend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase project URL and anon (public) key, used for auth only (phase 4)
NEXT_PUBLIC_SUPABASE_URL=REPLACE_ME
NEXT_PUBLIC_SUPABASE_ANON_KEY=REPLACE_ME

# Optional: Sentry DSN for the browser (leave empty to disable)
NEXT_PUBLIC_SENTRY_DSN=
